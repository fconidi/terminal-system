#!/bin/bash
set -e

case "$1" in
    configure)
        VERSION=$(dpkg-query -W -f='${Version}' terminal-system 2>/dev/null || echo "")
        echo ""
        echo "=================================================="
        echo "  terminal-system $VERSION installed"
        echo "=================================================="
        echo "  Requires the claude, codex and/or agy CLI,"
        echo "  already installed and authenticated."
        echo "  Start with:  terminal-system [claude|codex|agy]"
        echo "  Help:        terminal-system --help"
        echo ""
        ;;
esac
exit 0
