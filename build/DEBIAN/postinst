#!/bin/bash
set -e

case "$1" in
    configure)
        VERSION=$(dpkg-query -W -f='${Version}' terminal-system 2>/dev/null || echo "1.0.0")
        echo ""
        echo "=================================================="
        echo "  terminal-system $VERSION installed"
        echo "=================================================="
        echo "  Requires claude and/or codex CLI already installed."
        echo "  Start with:  terminal-system [claude|codex]"
        echo "  Help:        terminal-system --help"
        echo ""
        ;;
esac
exit 0
