#!/bin/bash
# terminal-system/build/usr/bin/terminal-system
# AI-assisted two-pane terminal: right pane takes natural-language
# instructions, left pane receives the generated shell commands.
set -uo pipefail

VERSION="1.1.0"
SCRIPT_LIBDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../lib/terminal-system" && pwd)"
if [ -f "$SCRIPT_LIBDIR/lib.sh" ]; then
    LIBDIR="$SCRIPT_LIBDIR"
else
    LIBDIR="/usr/lib/terminal-system"
fi
# shellcheck source=/usr/lib/terminal-system/lib.sh
. "$LIBDIR/lib.sh"

die() { echo "terminal-system: $*" >&2; exit 1; }

cmd_start() {
    local requested="${1:-}" engine session left_pane right_pane
    [ -n "${TMUX:-}" ] && die "already inside a tmux session -- detach or exit first (Ctrl+b d)."
    command -v tmux > /dev/null 2>&1 || die "tmux is not installed."

    if [ -n "$requested" ]; then
        engine="$(ts_pick_engine "$requested")" || die "no AI engine found (claude, codex)."
    else
        engine="$(ts_pick_engine claude)" 2> /dev/null || engine="$(ts_pick_engine codex)" 2> /dev/null || die "no AI engine found (claude, codex)."
    fi

    session="terminal-system-$$"
    left_pane="$(tmux new-session -d -s "$session" -n main -P -F '#{pane_id}')" || die "could not create the tmux session."
    tmux set-option -t "$session" mouse on
    tmux set-option -t "$session" history-limit 10000
    right_pane="$(tmux split-window -h -t "$left_pane" -P -F '#{pane_id}')" || die "could not create the tmux pane."
    tmux send-keys -t "$right_pane" "exec ts-brain '$session' '$left_pane' '$engine'" C-m
    exec tmux attach -t "$session"
}

cmd_help() {
    cat << EOF
terminal-system $VERSION -- AI-assisted two-pane terminal

Usage: terminal-system [claude|codex]

  Left pane: normal shell, where generated commands are typed and run.
  Right pane: type natural-language instructions.

  Right-pane commands:
    :cmd <command>          type a shell command manually, without AI
    :manual                 prompt for a manual shell command
    :auto on|off            toggle automatic execution
    :engine claude|codex    switch AI engine during the session
    :quit                   close the session

  Commands recognized as dangerous (rm -rf /, mkfs, dd to /dev, etc.)
  always require manual confirmation, even in auto-mode.
EOF
}

case "${1:-}" in
    -h|--help|help) cmd_help ;;
    -V|--version|version) echo "terminal-system $VERSION" ;;
    claude|codex|"") cmd_start "${1:-}" ;;
    *) cmd_help; exit 1 ;;
esac
