#!/bin/bash
# terminal-system/build/usr/bin/terminal-system
# AI-assisted two-panel terminal: right panel takes natural-language
# instructions, left panel receives the generated shell commands.
set -uo pipefail

VERSION="1.4.0"
SCRIPT_LIBDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../lib/terminal-system" && pwd)"
if [ -f "$SCRIPT_LIBDIR/lib.sh" ]; then
    LIBDIR="$SCRIPT_LIBDIR"
else
    LIBDIR="/usr/lib/terminal-system"
fi
# shellcheck source=/usr/lib/terminal-system/lib.sh
. "$LIBDIR/lib.sh"

die() { echo "terminal-system: $*" >&2; exit 1; }

cmd_start() {
    local requested="${1:-}" engine session left_pane right_pane sock_args=() brain
    [ -n "${TMUX:-}" ] && die "already inside a tmux session -- detach or exit first (Ctrl+b d)."
    command -v tmux > /dev/null 2>&1 || die "tmux is not installed."

    if [ -n "$requested" ]; then
        engine="$(ts_pick_engine "$requested")" || die "no AI engine found (claude, codex, agy)."
        [ "$engine" != "$requested" ] && echo "terminal-system: $requested is not installed; using $engine." >&2
    else
        engine="$(ts_pick_engine claude)" 2> /dev/null || engine="$(ts_pick_engine codex)" 2> /dev/null || engine="$(ts_pick_engine agy)" 2> /dev/null || die "no AI engine found (claude, codex, agy)."
    fi

    # A dedicated tmux server (via -L, a named socket in tmux's own socket
    # directory) instead of the user's default one: bind-key changes below
    # apply to whole key tables, not to a single session, so on the default
    # server they'd silently alter mouse-copy behavior in every other tmux
    # session the user has open. Tests override this via TS_TMUX_SOCK_ARGS.
    if [ -n "${TS_TMUX_SOCK_ARGS:-}" ]; then
        read -r -a sock_args <<< "$TS_TMUX_SOCK_ARGS"
    else
        sock_args=(-L "terminal-system-$$")
    fi

    session="terminal-system-$$"
    left_pane="$(tmux "${sock_args[@]}" new-session -d -s "$session" -n main -P -F '#{pane_id}')" || die "could not create the tmux session."
    tmux "${sock_args[@]}" set-option -t "$session" mouse on
    tmux "${sock_args[@]}" set-option -t "$session" history-limit 10000
    # Mouse mode routes mouse-drag selection through tmux copy-mode instead
    # of the terminal's native selection, in both panes. tmux's default
    # copy-pipe-and-cancel binding has no pipe target, so it only lands in
    # tmux's internal buffer; on VTE-based terminals (mate-terminal etc.),
    # which don't implement the OSC 52 fallback, that selection never
    # reaches the system clipboard. Pipe it to xclip explicitly.
    if command -v xclip > /dev/null 2>&1; then
        tmux "${sock_args[@]}" bind-key -T copy-mode MouseDragEnd1Pane send-keys -X copy-pipe-and-cancel "xclip -in -selection clipboard"
        tmux "${sock_args[@]}" bind-key -T copy-mode-vi MouseDragEnd1Pane send-keys -X copy-pipe-and-cancel "xclip -in -selection clipboard"
    fi
    # F9 / F10 (pause / resume of :watch) are bound by :watch itself, only
    # while the observer runs, so they stay free for mc, htop and the like.
    right_pane="$(tmux "${sock_args[@]}" split-window -h -t "$left_pane" -P -F '#{pane_id}')" || die "could not create the tmux pane."
    brain="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/ts-brain"
    [ -x "$brain" ] || brain="ts-brain"
    tmux "${sock_args[@]}" send-keys -t "$right_pane" "exec $(printf '%q' "$brain") '$session' '$left_pane' '$engine'" C-m
    if ! tmux "${sock_args[@]}" attach -t "$session"; then
        # No usable terminal: do not leave a session and a REPL running
        # unseen (TS_KEEP_SESSION=1 keeps it, for debugging and the test suite).
        [ "${TS_KEEP_SESSION:-0}" = "1" ] || tmux "${sock_args[@]}" kill-session -t "$session" > /dev/null 2>&1
        die "could not attach to the tmux session (is this a terminal?)."
    fi
    if tmux "${sock_args[@]}" has-session -t "$session" 2> /dev/null; then
        echo "terminal-system: detached; the session is still running."
        echo "Resume it with:  tmux ${sock_args[*]} attach -t $session"
    fi
}

cmd_help() {
    cat << EOF
terminal-system $VERSION -- AI-assisted two-panel terminal

Usage: terminal-system [claude|codex|agy]

  Left panel: normal shell, where generated commands are typed and run.
  Right panel: type natural-language instructions.

  Right-panel commands:
    :cmd <command>          type a shell command manually, without AI
    :manual                 prompt for a manual shell command
    :auto readonly|off      toggle automatic execution (read-only allowlist)
    :context on|off|show|clear   opt-in AI context from left-panel output
    :fix [on|off]           diagnose the last failed command (on = automatic)
    :follow <goal>          closed loop: step, check the output, next step
    :explain [command]      explain the last command/output, or a command
    :watch on|all|off       observer panel that advises on errors
    :watch pause|resume     stop/restart reading the left panel (F9 / F10)
    :engine claude|codex|agy   switch AI engine during the session
    :quit                   close the session

  Auto-mode only skips confirmation for a fixed allowlist of read-only
  commands, each with its own list of allowed options (ls, cat, grep, ps,
  git status/branch, systemctl status, and similar -- no redirects, pipes,
  substitution, or chaining, and no files that usually hold secrets). Anything
  else, plus a fixed set of always-dangerous patterns (rm -rf /, mkfs, dd
  to /dev, etc.), always requires manual confirmation.
EOF
}

case "${1:-}" in
    -h|--help|help) cmd_help ;;
    -V|--version|version) echo "terminal-system $VERSION" ;;
    claude|codex|agy|"") cmd_start "${1:-}" ;;
    *) echo "terminal-system: unknown argument: $1" >&2; cmd_help >&2; exit 1 ;;
esac
