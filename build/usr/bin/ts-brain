#!/bin/bash
# terminal-system/build/usr/bin/ts-brain
# Instruction REPL for terminal-system. Runs as the foreground process of
# the right-hand panel. Never called directly by a user — terminal-system
# launches it with: ts-brain <tmux-session> <left-pane-target> <engine>
set -uo pipefail

SCRIPT_LIBDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../lib/terminal-system" && pwd)"
if [ -f "$SCRIPT_LIBDIR/lib.sh" ]; then
    LIBDIR="$SCRIPT_LIBDIR"
else
    LIBDIR="/usr/lib/terminal-system"
fi
# shellcheck source=/usr/lib/terminal-system/lib.sh
. "$LIBDIR/lib.sh"

TS_SESSION="${1:?ts-brain: missing tmux session name}"
TS_TARGET="${2:?ts-brain: missing target pane}"
TS_ENGINE="${3:?ts-brain: missing engine}"
TS_OPERATOR="${TMUX_PANE:-}"
TS_WATCH_BIN="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/ts-watch"
TS_AUTO=0
TS_CONTEXT_ENABLED=0
TS_FIX_AUTO=0
TS_WATCH_PANE=""
TS_RESULTS=()
TS_LAST_CMD=""
TS_LAST_FAIL_CMD=""
TS_LAST_FAIL_RC=""
TS_LAST_FAIL_OUT=""
force_manual=0

TS_ENGINE="$(ts_pick_engine "$TS_ENGINE")" || { echo "ts-brain: no AI engine found (claude, codex, agy)."; exit 1; }

echo "terminal-system -- engine: $TS_ENGINE (auto: off, context: off)"
echo "Type an instruction, or :cmd <command>, :manual, :auto readonly|off, :context on|off|show|clear, :fix [on|off], :follow <goal>, :explain [command], :watch on|all|off|pause|resume, :engine claude|codex|agy, :quit"

ts_other_engine() {
    local e
    for e in "${TS_ENGINES[@]}"; do
        [ "$e" = "$1" ] && continue
        ts_resolve_bin "$e" > /dev/null 2>&1 && { echo "$e"; return 0; }
    done
    return 1
}

# Called after a command finished. Reports its exit status; on a real
# failure, remembers it for :fix (in memory only, redacted) and, if
# :fix on, diagnoses it right away.
ts_report_result() {
    local cmd="$1" signal="$2" rc
    rc="$(ts_read_rc "$signal")" || rc=""
    TS_LAST_CMD="$cmd"
    if [ -n "$rc" ] && [ "$rc" != "0" ]; then
        TS_RESULTS+=("$cmd (exit $rc)")
    else
        TS_RESULTS+=("$cmd")
    fi
    if [ -n "$rc" ] && ts_rc_is_failure "$cmd" "$rc"; then
        echo "-> ran: $cmd (exit $rc)"
        TS_LAST_FAIL_CMD="$cmd"
        TS_LAST_FAIL_RC="$rc"
        sleep 0.2
        TS_LAST_FAIL_OUT="$(ts_capture_pane_tail "$TS_TARGET" 30 | ts_redact_secrets)"
        if [ "$TS_FIX_AUTO" -eq 1 ]; then
            ts_fix
        else
            echo "   failed -- type :fix to diagnose it"
        fi
    else
        echo "-> ran: $cmd"
    fi
}

# Executes newline-separated commands in the left panel, one at a time.
# $2=1 forces confirmation for every command (auto-mode ignored).
# Fills the global array "executed".
ts_execute_commands() {
    local parsed="$1" manual="$2" cmd signal cmd_lines=()
    executed=()
    TS_BATCH_STOPPED=0
    mapfile -t cmd_lines <<< "$parsed"
    for cmd in "${cmd_lines[@]}"; do
        [ -z "$cmd" ] && continue
        if ! ts_pane_alive "$TS_TARGET"; then
            echo "left panel unavailable; closing the session."
            tmux kill-session -t "$TS_SESSION" 2> /dev/null
            exit 0
        fi
        signal="ts-done-$$-${RANDOM}${RANDOM}"
        if [ "$TS_AUTO" -eq 1 ] && [ "$manual" -eq 0 ] && [ "${TS_RISK[$cmd]:-}" != "high" ] && ts_is_safe_readonly_command "$cmd" && ! ts_is_dangerous_command "$cmd"; then
            # ts_auto_send types cmd itself (combined with the marker) --
            # no separate pre-type here, unlike the confirm branch below.
            ts_auto_send "$TS_TARGET" 0.3 "$cmd" "$TS_OPERATOR" "$signal"
            if ts_wait_command "$signal" "$cmd"; then
                ts_report_result "$cmd" "$signal"
                executed+=("$cmd")
            else
                # Signal never fired (e.g. stuck at a password prompt the
                # user hasn't answered yet). Typing the next queued command
                # now would land on that still-busy input line with no
                # separator, silently gluing two commands into one garbled
                # line. Stop the batch instead; remaining lines are lost.
                ts_wait_stopped_message
                TS_BATCH_STOPPED=1
                break
            fi
        else
            ts_type_into_pane "$TS_TARGET" "$cmd"
            if ts_confirm_and_send "$TS_TARGET" "$cmd" "$TS_OPERATOR" "$signal"; then
                if ts_wait_command "$signal" "${TS_CONFIRMED_COMMAND:-$cmd}"; then
                    ts_report_result "${TS_CONFIRMED_COMMAND:-$cmd}" "$signal"
                    executed+=("${TS_CONFIRMED_COMMAND:-$cmd}")
                else
                    ts_wait_stopped_message
                    TS_BATCH_STOPPED=1
                    break
                fi
            else
                echo "-> cancelled: $cmd"
                TS_BATCH_STOPPED=1
                break
            fi
        fi
    done
}

# Asks the engine why TS_LAST_FAIL_CMD failed. The explanation is printed;
# any fix command always goes through the confirm step (never auto-run,
# even in auto-mode).
ts_fix() {
    local raw prc
    if [ -z "$TS_LAST_FAIL_CMD" ]; then
        echo "nothing to fix: no failed command recorded."
        return 0
    fi
    echo "diagnosing: $TS_LAST_FAIL_CMD (exit $TS_LAST_FAIL_RC)"
    if ! raw="$(ts_call_engine "$TS_ENGINE" "$(ts_build_fix_prompt "$TS_LAST_FAIL_CMD" "$TS_LAST_FAIL_RC" "$TS_LAST_FAIL_OUT")" "$TS_FIX_SYSTEM_PROMPT")"; then
        echo "error: $TS_ENGINE did not respond; try :fix again or :engine."
        return 0
    fi
    TS_LAST_FAIL_CMD=""
    ts_parse_fix "$raw"; prc=$?
    [ -n "${TS_FIX_EXPLANATION//[[:space:]]/}" ] && printf 'cause: %s\n' "$TS_FIX_EXPLANATION"
    if [ "$prc" -eq 2 ]; then
        echo "no usable fix command in the reply."
        return 0
    fi
    [ -z "$TS_FIX_COMMANDS" ] && return 0
    ts_execute_commands "$TS_FIX_COMMANDS" 1
}

# :follow -- closed loop. Runs the model's next step, feeds the (redacted)
# output back, repeats until the model says DONE, a step is cancelled, the
# same command comes back twice, or TS_FOLLOW_MAX rounds have run. Every
# command still goes through the normal confirm / read-only auto path.
ts_follow() {
    local goal="$1" round steps="" raw prc out last_cmd="" step
    if [ -z "$goal" ]; then
        echo "usage: :follow <goal>"
        return 0
    fi
    echo "following: $goal (up to $TS_FOLLOW_MAX steps; each step's output, redacted, is sent back to the AI engine)"
    for ((round = 1; round <= TS_FOLLOW_MAX; round++)); do
        if ! raw="$(ts_call_engine "$TS_ENGINE" "$(ts_build_follow_prompt "$goal" "$steps")" "$TS_FOLLOW_SYSTEM_PROMPT")"; then
            echo "error: $TS_ENGINE did not respond; stopping."
            return 0
        fi
        ts_parse_follow "$raw"; prc=$?
        if [ "$prc" -eq 2 ]; then
            echo "unclear response; stopping:"
            echo "$raw"
            return 0
        fi
        if [ "$TS_FOLLOW_DONE" -eq 1 ]; then
            echo "done."
            [ -n "$TS_FOLLOW_SUMMARY" ] && printf '%s\n' "$TS_FOLLOW_SUMMARY"
            return 0
        fi
        if [ "$TS_FOLLOW_COMMANDS" = "$last_cmd" ]; then
            echo "the same step came back twice; stopping."
            return 0
        fi
        last_cmd="$TS_FOLLOW_COMMANDS"
        echo "step $round/$TS_FOLLOW_MAX"
        TS_RESULTS=()
        ts_execute_commands "$TS_FOLLOW_COMMANDS" 0
        if [ "$TS_BATCH_STOPPED" -eq 1 ]; then
            echo "following stopped; check the left panel before continuing."
            return 0
        fi
        if [ "${#executed[@]}" -eq 0 ]; then
            echo "no step ran; stopping."
            return 0
        fi
        sleep 0.3
        out="$(ts_capture_pane_tail "$TS_TARGET" 40 | ts_redact_secrets)"
        step="$(printf '%s\n' "${TS_RESULTS[@]}")"
        steps+="step ${round}: ${step}
output:
${out}
"
    done
    echo "step limit reached ($TS_FOLLOW_MAX); stopping. Run :follow again to continue."
}

# One-time acknowledgement that :watch sends terminal output to the AI
# provider. Remembered per user in the XDG state directory.
ts_watch_consent() {
    local dir file reply
    dir="${XDG_STATE_HOME:-$HOME/.local/state}/terminal-system"
    file="$dir/watch-consent"
    [ -f "$file" ] && return 0
    cat << 'NOTICE'
:watch reads the left panel and sends its recent output to the AI
provider you selected, through your authenticated CLI (normal account
usage). Secrets are redacted on a best-effort basis only. Press F9 or run
:watch pause at any time to stop it from reading anything.
NOTICE
    printf 'Allow this? y = yes, anything else = no: '
    IFS= read -r reply || return 1
    case "$reply" in
        y|Y|yes|YES)
            mkdir -p "$dir" 2> /dev/null && date +%F > "$file" 2> /dev/null
            return 0
            ;;
    esac
    echo "watch: not enabled"
    return 1
}

# :explain [command] -- explains a command, or (no argument) the last
# command that ran and what its output means.
ts_explain() {
    local arg="${1#"${1%%[![:space:]]*}"}" out
    if [ -n "$arg" ]; then
        ts_explain_command "$arg"
        return 0
    fi
    if [ -z "$TS_LAST_CMD" ]; then
        echo "nothing to explain yet: no command has run."
        return 0
    fi
    out="$(ts_capture_pane_tail "$TS_TARGET" 40 | ts_redact_secrets)"
    echo "explaining: $TS_LAST_CMD (its last output, redacted, is sent to $TS_ENGINE)"
    if ! out="$(ts_call_engine "$TS_ENGINE" "$(ts_env_context "$TS_TARGET")
Command: $TS_LAST_CMD
Terminal output:
$out" "$TS_EXPLAIN_RESULT_PROMPT")"; then
        echo "error: $TS_ENGINE did not respond."
        return 0
    fi
    printf '%s\n' "$out"
}

# :watch -- opens/closes the observer panel below this one.
ts_watch_alive() {
    [ -n "$TS_WATCH_PANE" ] && ts_pane_alive "$TS_WATCH_PANE"
}

ts_watch() {
    local mode="${1//[[:space:]]/}"
    case "$mode" in
        off)
            if ts_watch_alive; then
                tmux kill-pane -t "$TS_WATCH_PANE" 2> /dev/null
                echo "watch: off"
            else
                echo "watch: already off"
            fi
            TS_WATCH_PANE=""
            ;;
        on|all)
            [ "$mode" = "on" ] && mode="errors"
            if ts_watch_alive; then
                tmux kill-pane -t "$TS_WATCH_PANE" 2> /dev/null
            fi
            if [ ! -x "$TS_WATCH_BIN" ]; then
                echo "watch: ts-watch not found."
                return 0
            fi
            ts_watch_consent || return 0
            tmux set-option -t "$TS_SESSION" @ts_watch_paused 0 2> /dev/null
            TS_WATCH_PANE="$(tmux split-window -d -v -l 12 -t "$TS_OPERATOR" -P -F '#{pane_id}' \
                "PATH='$PATH' exec '$TS_WATCH_BIN' '$TS_TARGET' '$TS_ENGINE' '$mode'")" || { echo "watch: could not open the panel."; TS_WATCH_PANE=""; return 0; }
            echo "watch: on ($mode) -- the left panel's recent output (secrets redacted) is sent to $TS_ENGINE; advice appears in the panel below, nothing is typed for you"
            ;;
        pause|resume)
            if ! ts_watch_alive; then
                echo "watch: not running (use :watch on)"
                return 0
            fi
            if [ "$mode" = "pause" ]; then
                tmux set-option -t "$TS_SESSION" @ts_watch_paused 1
                echo "watch: paused -- nothing is read or sent"
            else
                tmux set-option -t "$TS_SESSION" @ts_watch_paused 0
                echo "watch: resumed"
            fi
            ;;
        *) echo "usage: :watch on|all|off|pause|resume" ;;
    esac
}

ts_run_manual_command() {
    local cmd="$1" output signal
    if [ -z "$cmd" ]; then
        echo "usage: :cmd <shell command>"
        return 0
    fi
    if ! ts_pane_alive "$TS_TARGET"; then
        echo "left panel unavailable; closing the session."
        tmux kill-session -t "$TS_SESSION" 2> /dev/null
        exit 0
    fi
    ts_type_into_pane "$TS_TARGET" "$cmd"
    signal="ts-done-$$-${RANDOM}${RANDOM}"
    if ts_confirm_and_send "$TS_TARGET" "$cmd" "$TS_OPERATOR" "$signal"; then
        if ts_wait_command "$signal" "${TS_CONFIRMED_COMMAND:-$cmd}"; then
            ts_report_result "${TS_CONFIRMED_COMMAND:-$cmd}" "$signal"
            sleep 0.2
            output="$(ts_capture_pane_tail "$TS_TARGET" 20)"
            ts_history_append "manual command" "${TS_CONFIRMED_COMMAND:-$cmd}" "$output"
        else
            ts_wait_stopped_message
        fi
    else
        echo "-> cancelled: $cmd"
    fi
}

while true; do
    printf '> '
    if [ -t 0 ]; then
        IFS= read -e -r instruction || break
    else
        IFS= read -r instruction || break
    fi
    [ -z "$instruction" ] && continue
    history -s "$instruction"

    case "$instruction" in
        :quit)
            tmux kill-session -t "$TS_SESSION" 2> /dev/null
            exit 0
            ;;
        ":auto on"|":auto readonly")
            TS_AUTO=1
            echo "auto-mode: on (read-only allowlist -- anything not on it, plus the fixed dangerous-pattern list, still asks)"
            continue
            ;;
        ":auto off") TS_AUTO=0; echo "auto-mode: off"; continue ;;
        ":context on")
            TS_CONTEXT_ENABLED=1
            echo "context: on -- recent left-panel output will be kept (redacted best-effort) and sent to the AI engine as context"
            continue
            ;;
        ":context off")
            TS_CONTEXT_ENABLED=0
            TS_HISTORY=()
            echo "context: off"
            continue
            ;;
        ":context show")
            if [ "${#TS_HISTORY[@]}" -eq 0 ]; then
                echo "(no context stored)"
            else
                ts_history_context
            fi
            continue
            ;;
        ":context clear")
            TS_HISTORY=()
            echo "context: cleared"
            continue
            ;;
        ":fix on") TS_FIX_AUTO=1; echo "fix: on -- a failed command's exit status and last 30 output lines (redacted) are sent to the AI engine automatically; fixes still ask for confirmation"; continue ;;
        ":fix off") TS_FIX_AUTO=0; echo "fix: off"; continue ;;
        ":fix") ts_fix; continue ;;
        ":explain"|":explain "*) ts_explain "${instruction#:explain}"; continue ;;
        ":watch"|":watch "*) ts_watch "${instruction#:watch}"; continue ;;
        ":follow"|":follow "*) ts_follow "${instruction#:follow}"; continue ;;
        :cmd)
            echo "usage: :cmd <shell command>"
            continue
            ;;
        :cmd\ *)
            ts_run_manual_command "${instruction#:cmd }"
            continue
            ;;
        :manual)
            printf 'manual command: '
            if [ -t 0 ]; then
                IFS= read -e -r manual_cmd || continue
            else
                IFS= read -r manual_cmd || continue
            fi
            ts_run_manual_command "$manual_cmd"
            continue
            ;;
        ":engine claude"|":engine codex"|":engine agy")
            requested="${instruction#:engine }"
            TS_ENGINE="$(ts_pick_engine "$requested")" || { echo "engine unavailable"; continue; }
            echo "engine: $TS_ENGINE"
            continue
            ;;
    esac

    prompt="$(ts_build_prompt "$instruction")"
    if ! raw="$(ts_call_engine "$TS_ENGINE" "$prompt")"; then
        failed_engine="$TS_ENGINE"
        fallback_engine="$(ts_other_engine "$failed_engine")"
        if ts_resolve_bin "$fallback_engine" > /dev/null 2>&1; then
            echo "error: $failed_engine did not respond; trying $fallback_engine."
            if raw="$(ts_call_engine "$fallback_engine" "$prompt")"; then
                TS_ENGINE="$fallback_engine"
                echo "engine: $TS_ENGINE"
            else
                echo "error: $failed_engine and $fallback_engine did not respond; rephrase the instruction."
                continue
            fi
        else
            echo "error: $failed_engine did not respond and no fallback is available; rephrase the instruction."
            continue
        fi
    fi

    force_manual=0
    ts_parse_structured "$raw"; src=$?
    if [ "$src" -eq 0 ]; then
        parsed="$TS_PARSED"; prc=0
    elif [ "$src" -eq 2 ]; then
        parsed="$raw"; prc=2
    else
        parsed="$(ts_parse_commands "$raw")"; prc=$?
    fi
    if [ "$prc" -eq 2 ]; then
        echo "unclear response:"
        echo "$parsed"
        printf 'continue anyway, confirming each line separately? enter=yes, n=cancel: '
        if ! IFS= read -r reply || [ "$reply" = "n" ] || [ "$reply" = "N" ]; then
            continue
        fi
        force_manual=1
        parsed="$raw"
    fi

    ts_execute_commands "$parsed" "$force_manual"

    sleep 0.2
    output="$(ts_capture_pane_tail "$TS_TARGET" 20)"
    ts_history_append "$instruction" "$(printf '%s\n' "${executed[@]:-}")" "$output"
done
