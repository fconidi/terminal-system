#!/bin/bash
# terminal-system/build/usr/bin/ts-brain
# Instruction REPL for terminal-system. Runs as the foreground process of
# the right-hand panel. Never called directly by a user — terminal-system
# launches it with: ts-brain <tmux-session> <left-pane-target> <engine>
set -uo pipefail

SCRIPT_LIBDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../lib/terminal-system" && pwd)"
if [ -f "$SCRIPT_LIBDIR/lib.sh" ]; then
    LIBDIR="$SCRIPT_LIBDIR"
else
    LIBDIR="/usr/lib/terminal-system"
fi
# shellcheck source=/usr/lib/terminal-system/lib.sh
. "$LIBDIR/lib.sh"

TS_SESSION="${1:?ts-brain: missing tmux session name}"
TS_TARGET="${2:?ts-brain: missing target pane}"
TS_ENGINE="${3:?ts-brain: missing engine}"
TS_OPERATOR="${TMUX_PANE:-}"
TS_AUTO=0
TS_CONTEXT_ENABLED=0
force_manual=0

TS_ENGINE="$(ts_pick_engine "$TS_ENGINE")" || { echo "ts-brain: no AI engine found (claude, codex)."; exit 1; }
TS_SHELL_NAME="$(ts_pane_shell_name "$TS_TARGET")"

echo "terminal-system -- engine: $TS_ENGINE (auto: off, context: off)"
echo "Type an instruction, or :cmd <command>, :manual, :auto readonly|off, :context on|off|show|clear, :engine claude|codex, :quit"

ts_other_engine() {
    case "$1" in
        claude) echo codex ;;
        codex) echo claude ;;
        *) return 1 ;;
    esac
}

ts_run_manual_command() {
    local cmd="$1" output
    if [ -z "$cmd" ]; then
        echo "usage: :cmd <shell command>"
        return 0
    fi
    if ! ts_pane_alive "$TS_TARGET"; then
        echo "left panel unavailable; closing the session."
        tmux kill-session -t "$TS_SESSION" 2> /dev/null
        exit 0
    fi
    ts_type_into_pane "$TS_TARGET" "$cmd"
    if ts_confirm_and_send "$TS_TARGET" "$cmd" "$TS_OPERATOR"; then
        ts_wait_pane_idle "$TS_TARGET" "$TS_SHELL_NAME" 120 || echo "(still running after 120s, continuing anyway)"
        echo "-> ran: ${TS_CONFIRMED_COMMAND:-$cmd}"
        sleep 0.2
        output="$(ts_capture_pane_tail "$TS_TARGET" 20)"
        ts_history_append "manual command" "${TS_CONFIRMED_COMMAND:-$cmd}" "$output"
    else
        echo "-> cancelled: $cmd"
    fi
}

while true; do
    printf '> '
    if [ -t 0 ]; then
        IFS= read -e -r instruction || break
    else
        IFS= read -r instruction || break
    fi
    [ -z "$instruction" ] && continue
    history -s "$instruction"

    case "$instruction" in
        :quit)
            tmux kill-session -t "$TS_SESSION" 2> /dev/null
            exit 0
            ;;
        ":auto on"|":auto readonly")
            TS_AUTO=1
            echo "auto-mode: on (read-only allowlist -- anything not on it, plus the fixed dangerous-pattern list, still asks)"
            continue
            ;;
        ":auto off") TS_AUTO=0; echo "auto-mode: off"; continue ;;
        ":context on")
            TS_CONTEXT_ENABLED=1
            echo "context: on -- recent left-panel output will be kept (redacted best-effort) and sent to the AI engine as context"
            continue
            ;;
        ":context off")
            TS_CONTEXT_ENABLED=0
            TS_HISTORY=()
            echo "context: off"
            continue
            ;;
        ":context show")
            if [ "${#TS_HISTORY[@]}" -eq 0 ]; then
                echo "(no context stored)"
            else
                ts_history_context
            fi
            continue
            ;;
        ":context clear")
            TS_HISTORY=()
            echo "context: cleared"
            continue
            ;;
        :cmd)
            echo "usage: :cmd <shell command>"
            continue
            ;;
        :cmd\ *)
            ts_run_manual_command "${instruction#:cmd }"
            continue
            ;;
        :manual)
            printf 'manual command: '
            if [ -t 0 ]; then
                IFS= read -e -r manual_cmd || continue
            else
                IFS= read -r manual_cmd || continue
            fi
            ts_run_manual_command "$manual_cmd"
            continue
            ;;
        ":engine claude"|":engine codex")
            requested="${instruction#:engine }"
            TS_ENGINE="$(ts_pick_engine "$requested")" || { echo "engine unavailable"; continue; }
            echo "engine: $TS_ENGINE"
            continue
            ;;
    esac

    prompt="$(ts_build_prompt "$instruction")"
    if ! raw="$(ts_call_engine "$TS_ENGINE" "$prompt")"; then
        failed_engine="$TS_ENGINE"
        fallback_engine="$(ts_other_engine "$failed_engine")"
        if ts_resolve_bin "$fallback_engine" > /dev/null 2>&1; then
            echo "error: $failed_engine did not respond; trying $fallback_engine."
            if raw="$(ts_call_engine "$fallback_engine" "$prompt")"; then
                TS_ENGINE="$fallback_engine"
                echo "engine: $TS_ENGINE"
            else
                echo "error: $failed_engine and $fallback_engine did not respond; rephrase the instruction."
                continue
            fi
        else
            echo "error: $failed_engine did not respond and no fallback is available; rephrase the instruction."
            continue
        fi
    fi

    force_manual=0
    parsed="$(ts_parse_commands "$raw")"; prc=$?
    if [ "$prc" -eq 2 ]; then
        echo "unclear response:"
        echo "$parsed"
        printf 'continue anyway, confirming each line separately? enter=yes, n=cancel: '
        if ! IFS= read -r reply || [ "$reply" = "n" ] || [ "$reply" = "N" ]; then
            continue
        fi
        force_manual=1
        parsed="$raw"
    fi

    executed=()
    mapfile -t cmd_lines <<< "$parsed"
    for cmd in "${cmd_lines[@]}"; do
        [ -z "$cmd" ] && continue
        if ! ts_pane_alive "$TS_TARGET"; then
            echo "left panel unavailable; closing the session."
            tmux kill-session -t "$TS_SESSION" 2> /dev/null
            exit 0
        fi
        ts_type_into_pane "$TS_TARGET" "$cmd"
        if [ "$TS_AUTO" -eq 1 ] && [ "$force_manual" -eq 0 ] && ts_is_safe_readonly_command "$cmd" && ! ts_is_dangerous_command "$cmd"; then
            ts_auto_send "$TS_TARGET" 0.3 "$cmd" "$TS_OPERATOR"
            if ts_wait_pane_idle "$TS_TARGET" "$TS_SHELL_NAME" 120; then
                echo "-> ran: $cmd"
                executed+=("$cmd")
            else
                # Pane never went idle (e.g. stuck at a password prompt the
                # user hasn't answered yet). Typing the next queued command
                # now would land on that still-busy input line with no
                # separator, silently gluing two commands into one garbled
                # line. Stop the batch instead; remaining lines are lost.
                echo "-> still running after 120s; stopping here so later commands aren't typed over it. Check the left panel, then re-issue the rest."
                break
            fi
        else
            if ts_confirm_and_send "$TS_TARGET" "$cmd" "$TS_OPERATOR"; then
                if ts_wait_pane_idle "$TS_TARGET" "$TS_SHELL_NAME" 120; then
                    echo "-> ran: ${TS_CONFIRMED_COMMAND:-$cmd}"
                    executed+=("${TS_CONFIRMED_COMMAND:-$cmd}")
                else
                    echo "-> still running after 120s; stopping here so later commands aren't typed over it. Check the left panel, then re-issue the rest."
                    break
                fi
            else
                echo "-> cancelled: $cmd"
            fi
        fi
    done

    sleep 0.2
    output="$(ts_capture_pane_tail "$TS_TARGET" 20)"
    ts_history_append "$instruction" "$(printf '%s\n' "${executed[@]:-}")" "$output"
done
