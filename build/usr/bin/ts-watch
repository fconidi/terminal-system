#!/bin/bash
# terminal-system/build/usr/bin/ts-watch
# Passive observer for terminal-system. Runs in its own small panel (opened
# by ":watch on" in ts-brain), reads the left panel and prints advice when
# something goes wrong. It never types into any panel.
# Usage: ts-watch <left-pane-target> <engine> <errors|all>
set -uo pipefail

SCRIPT_LIBDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../lib/terminal-system" && pwd)"
if [ -f "$SCRIPT_LIBDIR/lib.sh" ]; then
    LIBDIR="$SCRIPT_LIBDIR"
else
    LIBDIR="/usr/lib/terminal-system"
fi
# shellcheck source=/usr/lib/terminal-system/lib.sh
. "$LIBDIR/lib.sh"

TS_TARGET="${1:?ts-watch: missing target pane}"
TS_ENGINE="${2:?ts-watch: missing engine}"
MODE="${3:-errors}"
TS_ENGINE="$(ts_pick_engine "$TS_ENGINE")" || { echo "ts-watch: no AI engine found."; exit 1; }

WORK="$(mktemp -d)"
trap 'rm -rf "$WORK"' EXIT
: > "$WORK/analyzed"
: > "$WORK/current"

echo "watching the left panel (mode: $MODE, engine: $TS_ENGINE)."
echo "Its recent output (secrets redacted) is sent to the AI engine. F9 pauses, F10 resumes (or :watch pause / :watch resume); :watch off closes this panel."

lang="${TS_WATCH_LANGUAGE:-${LANG:-en}}"
session="$(tmux display-message -p -t "$TS_TARGET" '#{session_name}' 2> /dev/null)"
was_paused=0
last_hash=""
changed_at=0
first_change=0
last_request=0
pending=0
failures=0

while true; do
    sleep 1
    ts_pane_alive "$TS_TARGET" || exit 0
    now=$(date +%s)
    # Paused (F9, or :watch pause): nothing is read or sent. What appeared
    # while paused is marked as already seen, so it is never sent later.
    if [ -n "$session" ] && [ "$(tmux show-option -qv -t "$session" @ts_watch_paused 2> /dev/null)" = "1" ]; then
        if [ "$was_paused" -eq 0 ]; then
            was_paused=1
            printf '\n[%s] paused -- nothing is read or sent. F10 or :watch resume to continue.\n' "$(date +%H:%M:%S)"
        fi
        pending=0
        ts_watch_snapshot "$TS_TARGET" 120 > "$WORK/analyzed"
        last_hash="$(md5sum < "$WORK/analyzed")"
        continue
    fi
    if [ "$was_paused" -eq 1 ]; then
        was_paused=0
        printf '[%s] resumed.\n' "$(date +%H:%M:%S)"
    fi
    ts_watch_snapshot "$TS_TARGET" 120 > "$WORK/current"
    hash="$(md5sum < "$WORK/current")"
    if [ "$hash" != "$last_hash" ]; then
        last_hash="$hash"
        changed_at=$now
        [ "$pending" -eq 0 ] && first_change=$now
        pending=1
    fi
    [ "$pending" -eq 1 ] || continue
    # wait for output to settle (quiet period), but never longer than the max
    if [ $((now - changed_at)) -lt "$TS_WATCH_QUIET" ] && [ $((now - first_change)) -lt "$TS_WATCH_MAX_WAIT" ]; then
        continue
    fi
    [ $((now - last_request)) -ge "$TS_WATCH_MIN_INTERVAL" ] || continue
    # full-screen programs (vim, top, less) are not worth analysing
    if ts_pane_in_alt_screen "$TS_TARGET"; then
        continue
    fi
    pending=0
    ts_new_lines "$WORK/analyzed" "$WORK/current" > "$WORK/new"
    cp "$WORK/current" "$WORK/analyzed"
    [ -s "$WORK/new" ] || continue
    if [ "$MODE" = "errors" ] && ! ts_looks_like_problem < "$WORK/new"; then
        continue
    fi
    last_request=$(date +%s)
    prompt="$(ts_env_context "$TS_TARGET")
- language: $lang
Latest terminal output:
$(cat "$WORK/current")"
    if ! ts_ask "$prompt" "$TS_WATCH_SYSTEM_PROMPT"; then
        failures=$((failures + 1))
        echo "[$(date +%H:%M:%S)] no AI engine responded (attempt $failures)."
        if [ "$failures" -ge 3 ]; then
            echo "[$(date +%H:%M:%S)] still failing; trying again in 60 s. :watch off closes this panel."
            sleep 60
            failures=0
        fi
        continue
    fi
    failures=0
    reply="$TS_REPLY"
    [ "$(tr -d '[:space:]' <<< "$reply")" = "OK" ] && continue
    printf '\n[%s]\n%s\n' "$(date +%H:%M:%S)" "$(ts_clean_text <<< "$reply")"
done
