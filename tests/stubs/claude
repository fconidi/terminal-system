#!/bin/bash
# Stub for tests: mimics `claude -p ...` by printing $TS_STUB_RESPONSE.
[ -n "${TS_STUB_ARG_LOG:-}" ] && printf '%s\n' "$@" > "$TS_STUB_ARG_LOG"
if [ -n "${TS_STUB_SEQ_DIR:-}" ] && [ -d "$TS_STUB_SEQ_DIR" ]; then
    n=$(( $(cat "$TS_STUB_SEQ_DIR/.n" 2>/dev/null || echo 0) + 1 )); echo "$n" > "$TS_STUB_SEQ_DIR/.n"
    [ -f "$TS_STUB_SEQ_DIR/$n" ] || n=$(ls "$TS_STUB_SEQ_DIR" | grep -E '^[0-9]+$' | sort -n | tail -1)
    cat "$TS_STUB_SEQ_DIR/$n"; exit 0
fi
if [ -n "${TS_STUB_RESPONSE_FILE:-}" ] && [ -f "$TS_STUB_RESPONSE_FILE" ]; then cat "$TS_STUB_RESPONSE_FILE"; exit 0; fi
printf '%s\n' "${TS_STUB_RESPONSE_CLAUDE:-${TS_STUB_RESPONSE:-}}"
exit "${TS_STUB_EXIT_CLAUDE:-${TS_STUB_EXIT:-0}}"
